[Unit]
Description=Gas Sensor Agent — reads Arduino serial and sends to dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asim
WorkingDirectory=/home/asim/gas-sensors/hardware/raspberry-pi
ExecStart=/home/asim/gas-sensors/hardware/raspberry-pi/venv/bin/python /home/asim/gas-sensors/hardware/raspberry-pi/agent.py
Restart=always
RestartSec=5
Environment=INGEST_SECRET=""
Environment=DASHBOARD_URL="http://localhost:3000"
Environment=SERIAL_PORT="/dev/ttyACM0"
Environment=BAUD_RATE="115200"

[Install]
WantedBy=multi-user.target
